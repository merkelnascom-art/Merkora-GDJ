# Configure only after verifying the dedicated MerKora GDJ Supabase project and RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public absolute MCP endpoint URL; set to the canonical HTTPS URL after domain/deployment setup.
MERKORA_MCP_RESOURCE_URL=

# Keep MCP project reads disabled until the reviewed OAuth-specific RLS policies are applied.
MERKORA_MCP_DATA_ACCESS_ENABLED=false

# AI is disabled by default. Enable only after setting an AI Gateway key and budget.
MERKORA_AI_ENABLED=false
AI_GATEWAY_API_KEY=
MERKORA_AI_MODEL=provider/model-from-the-live-gateway-catalog
MERKORA_AI_MODEL_CONVERSATION=
MERKORA_AI_MODEL_ANALYSIS=
MERKORA_AI_MODEL_ARCHITECTURE=
MERKORA_AI_MODEL_CODE_REVIEW=

# Multi-provider agent runtime remains disabled until project ACLs, consent,
# durable budgets, audit storage and the execution worker are production-ready.
MERKORA_AGENT_RUNTIME_ENABLED=false
MERKORA_ORGANIZATION_ID=

# Outbound provider API credentials: server-only, never NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server-approved provider model IDs. Leave blank until verified for each account.
MERKORA_OPENAI_MODEL_FAST=
MERKORA_OPENAI_MODEL_BALANCED=
MERKORA_OPENAI_MODEL_DEEP=
MERKORA_OPENAI_MODEL_REVIEW=
MERKORA_ANTHROPIC_MODEL_FAST=
MERKORA_ANTHROPIC_MODEL_BALANCED=
MERKORA_ANTHROPIC_MODEL_DEEP=
MERKORA_ANTHROPIC_MODEL_REVIEW=
MERKORA_GEMINI_MODEL_FAST=
MERKORA_GEMINI_MODEL_BALANCED=
MERKORA_GEMINI_MODEL_DEEP=
MERKORA_GEMINI_MODEL_REVIEW=
