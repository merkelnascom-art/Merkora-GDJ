# Configure only after verifying the dedicated MerKora GDJ Supabase project and RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public absolute MCP endpoint URL; set to the canonical HTTPS URL after domain/deployment setup.
MERKORA_MCP_RESOURCE_URL=

# AI is disabled by default. Enable only after setting an AI Gateway key and budget.
MERKORA_AI_ENABLED=false
AI_GATEWAY_API_KEY=
MERKORA_AI_MODEL=provider/model-from-the-live-gateway-catalog
MERKORA_AI_MODEL_CONVERSATION=
MERKORA_AI_MODEL_ANALYSIS=
MERKORA_AI_MODEL_ARCHITECTURE=
MERKORA_AI_MODEL_CODE_REVIEW=
